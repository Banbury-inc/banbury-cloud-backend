{
  "family": "banbury-cloud-daemon",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::145023116180:role/ecsTaskExecutionRole",
  "containerDefinitions": [
    {
      "name": "banbury-backend-daemon-dev",
      "image": "145023116180.dkr.ecr.us-east-1.amazonaws.com/banbury-backend-dev:latest",
      "essential": true,
      "command": ["python", "manage.py", "process_taskstudio_daemon", "--adaptive", "--batch", "50"],
      "environment": [
        {"name": "BANBURY_WEBSITE_ORIGIN", "value": "https://app.dev.banbury.io"},
        {"name": "BANBURY_API_BASE", "value": "https://api.dev.banbury.io"}
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/banbury-cloud-daemon",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "ecs",
          "awslogs-create-group": "true"
        }
      }
    }
  ]
}

